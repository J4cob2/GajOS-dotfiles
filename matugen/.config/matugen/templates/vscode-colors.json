{
  "name": "Matugen",
  "type": "dark",
  "colors": {
    "editor.background": "{{colors.surface.default.hex}}",
    "editor.foreground": "{{colors.on_surface.default.hex}}",
    "editorCursor.foreground": "{{colors.primary.default.hex}}",
    "editor.selectionBackground": "{{colors.primary_container.default.hex}}",
    "editor.lineHighlightBackground": "{{colors.surface_container.default.hex}}",
    "sideBar.background": "{{colors.surface_container.default.hex}}",
    "sideBar.foreground": "{{colors.on_surface_variant.default.hex}}",
    "activityBar.background": "{{colors.surface.default.hex}}",
    "activityBar.foreground": "{{colors.primary.default.hex}}",
    "statusBar.background": "{{colors.surface_container.default.hex}}",
    "statusBar.foreground": "{{colors.on_surface_variant.default.hex}}",
    "titleBar.activeBackground": "{{colors.surface.default.hex}}",
    "tab.activeBackground": "{{colors.primary.default.hex}}",
    "tab.activeForeground": "{{colors.on_primary.default.hex}}",
    "tab.inactiveBackground": "{{colors.surface_container.default.hex}}",
    "tab.inactiveForeground": "{{colors.on_surface_variant.default.hex}}",
    "terminal.background": "{{colors.surface.default.hex}}",
    "terminal.foreground": "{{colors.on_surface.default.hex}}",
    "terminal.ansiBlack": "{{colors.surface_container.default.hex}}",
    "terminal.ansiRed": "{{colors.error.default.hex}}",
    "terminal.ansiGreen": "{{colors.tertiary.default.hex}}",
    "terminal.ansiYellow": "{{colors.secondary.default.hex}}",
    "terminal.ansiBlue": "{{colors.primary.default.hex}}",
    "terminal.ansiMagenta": "{{colors.tertiary.default.hex}}",
    "terminal.ansiCyan": "{{colors.secondary.default.hex}}",
    "terminal.ansiWhite": "{{colors.on_surface_variant.default.hex}}"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "{{colors.outline.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["string"], "settings": { "foreground": "{{colors.tertiary.default.hex}}" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "{{colors.primary.default.hex}}" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "{{colors.secondary.default.hex}}" } },
    { "scope": ["constant", "variable.other.constant"], "settings": { "foreground": "{{colors.error.default.hex}}" } }
  ]
}